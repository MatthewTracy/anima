{
    "name": "anima",
    "version": "0.1.0",
    "description": "Multi-agent LLM simulation framework with persistent souls. Forum + Cloister reference scenarios.",
    "type": "module",
    "private": true,
    "dependencies": {
        "@anthropic-ai/sdk": "^0.17.1",
        "@cerebras/cerebras_cloud_sdk": "^1.46.0",
        "@google/genai": "^1.15.0",
        "@huggingface/inference": "^2.8.1",
        "@mistralai/mistralai": "^1.1.0",
        "canvas": "^3.1.0",
        "cheerio": "^1.0.0",
        "express": "^4.18.2",
        "google-translate-api-x": "^10.7.1",
        "groq-sdk": "^0.15.0",
        "minecraft-data": "^3.97.0",
        "mineflayer": "^4.33.0",
        "mineflayer-armor-manager": "^2.0.1",
        "mineflayer-auto-eat": "^3.3.6",
        "mineflayer-collectblock": "^1.4.1",
        "mineflayer-pathfinder": "^2.4.5",
        "mineflayer-pvp": "^1.3.2",
        "node-canvas-webgl": "^0.3.0",
        "open": "^10.2.0",
        "openai": "^4.4.0",
        "prismarine-item": "^1.15.0",
        "prismarine-viewer": "^1.32.0",
        "puppeteer": "^24.41.0",
        "ffmpeg-static": "^5.2.0",
        "replicate": "^0.29.4",
        "ses": "^1.9.1",
        "socket.io": "^4.7.2",
        "socket.io-client": "^4.7.2",
        "three": "^0.128.0",
        "vec3": "^0.1.10",
        "yargs": "^17.7.2"
    },
    "overrides": {
        "canvas": "^3.1.0",
        "gl": "^8.1.6"
    },
    "scripts": {
        "postinstall": "patch-package",
        "start": "node main.js",
        "forum": "node scripts/run_scenario.js forum",
        "cloister": "node scenarios/cloister/runner.js",
        "outpost": "node scenarios/outpost/runner.js",
        "crew": "node scenarios/crew/runner.js",
        "cell": "node scenarios/cell/runner.js",
        "souls": "node scripts/soul_inspector.js",
        "substrate": "node scripts/inspect_substrate.js",
        "substrate-diff": "node scripts/substrate_diff.js",
        "substrate-all": "node scripts/substrate_all.js",
        "substrate-demo": "node scripts/substrate_demo.js",
        "feuds": "node scripts/feud_inspector.js",
        "library": "node scripts/library_search.js",
        "publish": "node scripts/publish_game.js",
        "demo": "node scripts/seed_demo_cohort.js && node scripts/publish_game.js --scenario cloister --roster BrotherG,BrotherA,BrotherT,BrotherB,BrotherL,BrotherW",
        "test": "node scripts/run_tests.js",
        "score": "node scripts/score_game.js",
        "analyze": "node scripts/analyze_runs.js",
        "replay": "node scripts/replay.js",
        "record": "node scripts/record.js",
        "convert-video": "node scripts/frames_to_video.js",
        "tournament": "node scripts/tournament.js",
        "sweep": "node scripts/sweep.js",
        "highlights": "node scripts/highlights.js",
        "clean-logs": "node scripts/clean_logs.js"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "eslint": "^9.13.0",
        "eslint-plugin-no-floating-promise": "^2.0.0",
        "globals": "^15.11.0",
        "patch-package": "^8.0.0"
    }
}
